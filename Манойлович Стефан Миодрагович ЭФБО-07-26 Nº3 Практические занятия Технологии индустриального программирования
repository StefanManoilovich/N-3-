4. Объектно-ориентированный способ
Здесь используются классы и объекты.
Задача 1
object_oriented/task1.cpp
#include <iostream>#include <cmath>
using namespace std;
class Triangle
{private:
    double a;
    double b;
public:
    Triangle(double a, double b)
    {
        this->a = a;
        this->b = b;
    }

    double getHypotenuse()
    {
        return sqrt(a * a + b * b);
    }
};
int main()
{
    double a, b;
    cin >> a >> b;

    Triangle triangle(a, b);

    cout << triangle.getHypotenuse() << endl;

    return 0;
}
Задача 3
object_oriented/task3.cpp
#include <iostream>
using namespace std;
class Number
{private:
    int n;
public:
    Number(int n)
    {
        this->n = n;
    }

    int getTens()
    {
        return (n / 10) % 10;
    }
};
int main()
{
    int n;
    cin >> n;

    Number number(n);

    cout << number.getTens() << endl;

    return 0;
}
